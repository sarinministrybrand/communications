# Copy to .env and fill in. Nothing secret has a default: a blank credential
# fails at boot instead of silently using someone else's key.

DATABASE_URL=postgresql://comms:comms@db:5432/comms
REDIS_URL=redis://redis:6379/0

# --- Esendex / CDYNE
ESENDEX_SEND_URL=https://sms2tls.esendex.us/sms.svc/WS
ESENDEX_POSTBACK_URL=https://comms.example.com/webhooks/esendex
ESENDEX_DEFAULT_LICENSE_KEY=
ESENDEX_DEFAULT_SHORT_CODE=

# --- Embed. Comma separated. "*" is refused: a wildcard lets any site frame a
# signed-in church's inbox.
EMBED_ALLOWED_ORIGINS=https://app.ministrybrands.com

# --- Throughput
SEND_BATCH_SIZE=2000
SEND_CONCURRENCY=16
FANOUT_CHUNK=10000

# 1 = skip auth and serve the widget to localhost. Never set in production.
DEV_MODE=0
